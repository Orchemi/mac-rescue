# SSH CONNECTION
# 개인정보는 모두 마스킹되어 있습니다. ***는 비어 있는 값처럼 처리합니다.
# 별칭: 기본값 "내 Mac". 공백을 쓸 때는 따옴표로 감싸세요.
RESCUE_HOST_ALIAS=***
# Mac의 짧은 계정 이름. 비워 두면 현재 OS 계정을 자동 감지합니다.
RESCUE_SSH_USER=***
# 저장된 Tailscale 주소. 현재 Mac의 실제 주소가 있으면 그것을 우선합니다.
RESCUE_TAILSCALE_IP=***
# 공개 기본값. macOS SSH의 기본 포트입니다.
RESCUE_SSH_PORT=22
# 비밀번호, 개인키, API 토큰은 이 파일에 추가하지 마세요.
